# API keys for re-running the experiments.
#
# Copy this file to config/.env and fill in your own keys. Keep config/.env out of version control.
# None of these keys is needed to reproduce the numbers and figures from the released data.

# Model providers used to collect the product dataset
ANTHROPIC_API_KEY=sk-ant-...             # Anthropic
OPENAI_API_KEY=sk-...                    # OpenAI (also used for the fine-tuning experiments)
GOOGLE_API_KEY=AIza...                   # Google AI Studio (Gemini and Gemma)
GOOGLE_VERTEX_API_KEY=...                # Google Vertex AI (optional)
OPENROUTER_API_KEY=sk-or-v1-...          # OpenRouter (Llama, DeepSeek, Qwen, Kimi and others)

# Open-weight models for probing, steering and base-versus-instruct comparisons (run on Modal)
HUGGINGFACE_TOKEN=hf_...                 # Hugging Face (model weights)
TOGETHER_API_KEY=...                     # Together AI (optional; base models for the base-versus-instruct comparison)

# Survey platform (only to export data from your own Qualtrics surveys)
QUALTRICS_API_TOKEN=...                  # Qualtrics REST API token
